  "item": [
    {
      "name": "0. Viva REST — авторизация (bor.json)",
      "description": "Прямые запросы к Viva: сначала **Get Access Token**, затем методы с `Authorization: Bearer {{viva_token}}`. Имитирует то, что делает `internal/vivaclient` внутри viva-api.",
      "item": [
        {
          "name": "Get Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('viva_token', jsonData.access_token);",
                  "    console.log('viva_token сохранён в коллекцию');",
                  "} else {",
                  "    console.error('Ошибка: ' + pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{viva_username}}\",\n  \"password\": \"{{viva_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{viva_base_url}}/auth/token",
            "description": "§2.1 Getting an Access Token — тот же контракт, что `internal/vivaclient` → `POST {baseURL}/auth/token` (userName / password)."
          },
          "response": []
        },
        {
          "name": "GetSubscriberInfo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{viva_token}}"
              }
            ],
            "url": "{{viva_base_url}}/api/Subscriber/{{msisdn}}",
            "description": "§3.1 GetSubscriberInfo. Сначала выполните Get Access Token. Ожидаемые HTTP: 200, 404, 429 (см. viva.md)."
          },
          "response": []
        },
        {
          "name": "Ping API (OPTIONS /auth/token)",
          "request": {
            "method": "OPTIONS",
            "header": [],
            "url": "{{viva_base_url}}/auth/token",
            "description": "§2.4 — проверка доступности API без тела и без выдачи токена."
          },
          "response": []
        },
        {
          "name": "AddTariffPlanProduct",
          "request": {
            "method": "POST",
            "header": [
