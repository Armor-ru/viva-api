                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tpProduct\": {\n    \"msisdn\": \"{{msisdn}}\",\n    \"subNo\": {{viva_sub_no}},\n    \"expDate\": null,\n    \"prodId\": {{viva_tp_prod_id}}\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{viva_base_url}}/api/Subscriber/AddTariffPlanProduct",
            "description": "§3.2 — тело `tpProduct` (**TpProductDTO**, §4.3). Перед вызовом обновите `viva_sub_no` / `viva_tp_prod_id` из GetSubscriberInfo. Ожидаемые HTTP: 200, 400, 429."
